# ==================== 数据库 ====================
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/Person_Growth_Agent

# ==================== LLM（FastAPI 路径，anthropic 协议） ====================
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.teamorouter.cn
LLM_MODEL=glm-5.3-flash
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ==================== JWT ====================
SECRET_KEY=please-change-to-a-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== LangGraph agents 的模型选择 ====================
# LLM_PROVIDER：ollama（本地）或 openai（兼容 OpenAI 协议的远程）
LLM_PROVIDER=ollama
# 本地 Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# 选 openai 时，复用上面的 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL
