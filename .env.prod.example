# ===== 生产环境变量（在服务器上复制为 .env 并填真实值，.env 不要提交 git）=====

# 数据库 root 强密码：在服务器执行 `openssl rand -hex 16` 生成
DB_PASSWORD=

# 远程 LLM（走 OpenAI 兼容接口，云上不需要 Ollama）
LLM_API_KEY=
LLM_BASE_URL=https://api.teamorouter.cn
LLM_MODEL=glm-5.3-flash
LLM_TIMEOUT=90

# FastAPI/JWT 密钥：在服务器执行 `openssl rand -hex 32` 生成
SECRET_KEY=

# BYOK 凭证加密密钥：在服务器执行
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空则自动从 SECRET_KEY 派生（可用，但建议生产显式设置）
CREDENTIAL_ENCRYPTION_KEY=

# 域名（阶段②买完再填，只填主域名，如 example.com；Caddyfile 会自动拼 app./api.）
DOMAIN=
